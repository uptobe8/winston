#define name Gestor Inteligente de Archivos
#define color blue
#define glyph folder
#define version 18
#define mac false

#include 'actions/documents'
#include 'actions/calendar'
#include 'actions/text'

action 'file.move' moveFile(&variable file: 'WFFile', &variable folder: 'WFFolder', bool ?replaceExisting: 'WFReplaceExisting' = false)

menu "Gestor Inteligente de Archivos" {
    item "Organizar archivos":
        menu "Cómo quieres organizarlos" {
            item "Cliente o proyecto":
                @rootClient = selectFolder(false)
                @clientItems = getFolderContents(@rootClient, false)
                @clientSelected = chooseFromList(@clientItems, "Selecciona los archivos del cliente o proyecto", true, false)
                @clientNameInput = prompt("Nombre del cliente o proyecto", "Text", "Proyecto")
                @clientName = text(@clientNameInput)
                @clientFolder = createFolder(@clientName, @rootClient)
                for clientFile in @clientSelected {
                    moveFile(@clientFile, @clientFolder, false)
                    deleteFiles(@clientFile, false)
                }
                alert("Archivos organizados en la carpeta del cliente o proyecto.")

            item "Viaje":
                @rootTrip = selectFolder(false)
                @tripItems = getFolderContents(@rootTrip, false)
                @tripSelected = chooseFromList(@tripItems, "Selecciona los archivos del viaje", true, false)
                @tripNameInput = prompt("Nombre del viaje", "Text", "Viaje")
                @tripName = text(@tripNameInput)
                @tripFolder = createFolder(@tripName, @rootTrip)
                for tripFile in @tripSelected {
                    moveFile(@tripFile, @tripFolder, false)
                    deleteFiles(@tripFile, false)
                }
                alert("Archivos organizados en la carpeta del viaje.")

            item "Persona":
                @rootPerson = selectFolder(false)
                @personItems = getFolderContents(@rootPerson, false)
                @personSelected = chooseFromList(@personItems, "Selecciona los archivos relacionados con esa persona", true, false)
                @personNameInput = prompt("Nombre de la persona", "Text", "Persona")
                @personName = text(@personNameInput)
                @personFolder = createFolder(@personName, @rootPerson)
                for personFile in @personSelected {
                    moveFile(@personFile, @personFolder, false)
                    deleteFiles(@personFile, false)
                }
                alert("Archivos organizados en la carpeta de la persona.")

            item "Versiones de algo":
                @rootVersion = selectFolder(false)
                @versionItems = getFolderContents(@rootVersion, false)
                @versionSelected = chooseFromList(@versionItems, "Selecciona borradores, copias y versiones", true, false)
                @versionNameInput = prompt("Nombre del trabajo o documento", "Text", "Versiones")
                @versionName = text(@versionNameInput)
                @versionFolder = createFolder(@versionName, @rootVersion)
                for versionFile in @versionSelected {
                    moveFile(@versionFile, @versionFolder, false)
                    deleteFiles(@versionFile, false)
                }
                alert("Versiones agrupadas.")

            item "Clasificación automática":
                @rootAuto = selectFolder(false)
                @autoItems = getFolderContents(@rootAuto, false)
                @screensFolder = createFolder("01_Capturas", @rootAuto)
                @imagesFolder = createFolder("02_Imagenes", @rootAuto)
                @videosFolder = createFolder("03_Videos", @rootAuto)
                @documentsFolder = createFolder("04_Documentos", @rootAuto)
                @archivesFolder = createFolder("05_Comprimidos", @rootAuto)
                @versionsFolder = createFolder("06_Versiones_y_copias", @rootAuto)
                @otherFolder = createFolder("07_Otros", @rootAuto)
                @organized = 0

                for autoFile in @autoItems {
                    @autoType = typeOf(@autoFile)
                    if @autoType != "Folder" {
                        @autoName = getFileDetail(@autoFile, "Name")
                        @autoNameLower = lowercase(@autoName)
                        @autoExtension = getFileDetail(@autoFile, "File Extension")
                        @autoExtensionLower = lowercase(@autoExtension)
                        @destination = @otherFolder

                        if @autoNameLower contains "screenshot" || @autoNameLower contains "captura" || @autoNameLower contains "pantallazo" {
                            @destination = @screensFolder
                        } else {
                            if @autoNameLower contains "version" || @autoNameLower contains "versión" || @autoNameLower contains "final" || @autoNameLower contains "borrador" || @autoNameLower contains "draft" || @autoNameLower contains "copia" || @autoNameLower contains "copy" || @autoNameLower contains " v1" || @autoNameLower contains " v2" || @autoNameLower contains " v3" || @autoNameLower contains " v4" || @autoNameLower contains " v5" {
                                @destination = @versionsFolder
                            } else {
                                if @autoExtensionLower == "jpg" || @autoExtensionLower == "jpeg" || @autoExtensionLower == "png" || @autoExtensionLower == "heic" || @autoExtensionLower == "webp" || @autoExtensionLower == "gif" || @autoExtensionLower == "tif" || @autoExtensionLower == "tiff" {
                                    @destination = @imagesFolder
                                } else {
                                    if @autoExtensionLower == "mp4" || @autoExtensionLower == "mov" || @autoExtensionLower == "m4v" || @autoExtensionLower == "avi" || @autoExtensionLower == "mkv" || @autoExtensionLower == "webm" {
                                        @destination = @videosFolder
                                    } else {
                                        if @autoExtensionLower == "pdf" || @autoExtensionLower == "doc" || @autoExtensionLower == "docx" || @autoExtensionLower == "xls" || @autoExtensionLower == "xlsx" || @autoExtensionLower == "ppt" || @autoExtensionLower == "pptx" || @autoExtensionLower == "txt" || @autoExtensionLower == "rtf" || @autoExtensionLower == "pages" || @autoExtensionLower == "numbers" || @autoExtensionLower == "key" || @autoExtensionLower == "csv" {
                                            @destination = @documentsFolder
                                        } else {
                                            if @autoExtensionLower == "zip" || @autoExtensionLower == "rar" || @autoExtensionLower == "7z" || @autoExtensionLower == "gz" || @autoExtensionLower == "tar" {
                                                @destination = @archivesFolder
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        moveFile(@autoFile, @destination, false)
                        deleteFiles(@autoFile, false)
                        @organized += 1
                    }
                }
                alert("Se han organizado {@organized} archivos.", "Organización terminada")
        }

    item "Informe para borrar":
        @reportRoot = selectFolder(false)
        @reportItems = getFolderContents(@reportRoot, true)
        @largestItems = filterFiles(@reportItems, 50, "File Size", "Biggest First")
        @oldestItems = filterFiles(@reportItems, 100, "Last Modified Date", "Oldest First")
        @reportText = "INFORME DE ARCHIVOS PARA REVISAR\n\nNOTA: iPhone no expone la fecha de última apertura. El criterio equivalente disponible es la última modificación.\n\n50 ARCHIVOS MÁS PESADOS\n"

        for largeFile in @largestItems {
            @largeType = typeOf(@largeFile)
            if @largeType != "Folder" {
                @largeName = getFileDetail(@largeFile, "Name")
                @largeSize = fileSize(@largeFile, "Megabytes")
                @largeModified = getFileDetail(@largeFile, "Last Modified Date")
                @largeModifiedText = formatTimestamp(@largeModified, "Short", "Short")
                @largePath = getFileDetail(@largeFile, "File Path")
                @reportText += "\n{@largeName}\nTamaño: {@largeSize} MB | Modificado: {@largeModifiedText}\n{@largePath}\n"
            }
        }

        @reportText += "\n\n100 ARCHIVOS MÁS ANTIGUOS POR ÚLTIMA MODIFICACIÓN\n"

        for oldReportFile in @oldestItems {
            @oldReportType = typeOf(@oldReportFile)
            if @oldReportType != "Folder" {
                @oldReportName = getFileDetail(@oldReportFile, "Name")
                @oldReportSize = fileSize(@oldReportFile, "Megabytes")
                @oldReportModified = getFileDetail(@oldReportFile, "Last Modified Date")
                @oldReportModifiedText = formatTimestamp(@oldReportModified, "Short", "Short")
                @oldReportPath = getFileDetail(@oldReportFile, "File Path")
                @reportText += "\n{@oldReportName}\nTamaño: {@oldReportSize} MB | Modificado: {@oldReportModifiedText}\n{@oldReportPath}\n"
            }
        }

        @reportDocument = text(@reportText)
        @namedReport = setName(@reportDocument, "Informe_archivos_para_borrar.txt", true)
        quicklook(@namedReport)
        menu "Informe preparado" {
            item "Guardar informe":
                saveFilePrompt(@namedReport, false)
            item "Cerrar":
                nothing()
        }

    item "Limpiar archivos":
        menu "Qué quieres revisar" {
            item "Archivos más pesados":
                @heavyRoot = selectFolder(false)
                @heavyAll = getFolderContents(@heavyRoot, true)
                @heavyCandidates = filterFiles(@heavyAll, 50, "File Size", "Biggest First")
                @heavySelected = chooseFromList(@heavyCandidates, "Selecciona los archivos que quieres eliminar", true, false)
                @heavyCount = count(@heavySelected)
                confirm("Se enviarán {@heavyCount} archivos a Eliminados recientemente.", "Confirmar limpieza")
                deleteFiles(@heavySelected, false)
                alert("Limpieza terminada.")

            item "Archivos más antiguos":
                @oldRoot = selectFolder(false)
                @oldAll = getFolderContents(@oldRoot, true)
                @oldCandidates = filterFiles(@oldAll, 100, "Last Modified Date", "Oldest First")
                @oldSelected = chooseFromList(@oldCandidates, "Selecciona los archivos antiguos que quieres eliminar", true, false)
                @oldCount = count(@oldSelected)
                confirm("Se enviarán {@oldCount} archivos a Eliminados recientemente.", "Confirmar limpieza")
                deleteFiles(@oldSelected, false)
                alert("Limpieza terminada.")

            item "Versiones, copias y borradores":
                @duplicatesRoot = selectFolder(false)
                @duplicatesAll = getFolderContents(@duplicatesRoot, true)
                @duplicatesCandidates: array

                for duplicateFile in @duplicatesAll {
                    @duplicateType = typeOf(@duplicateFile)
                    if @duplicateType != "Folder" {
                        @duplicateName = getFileDetail(@duplicateFile, "Name")
                        @duplicateNameLower = lowercase(@duplicateName)
                        if @duplicateNameLower contains "version" || @duplicateNameLower contains "versión" || @duplicateNameLower contains "final" || @duplicateNameLower contains "borrador" || @duplicateNameLower contains "draft" || @duplicateNameLower contains "copia" || @duplicateNameLower contains "copy" || @duplicateNameLower contains " v1" || @duplicateNameLower contains " v2" || @duplicateNameLower contains " v3" || @duplicateNameLower contains " v4" || @duplicateNameLower contains " v5" {
                            @duplicatesCandidates += @duplicateFile
                        }
                    }
                }

                @duplicatesSelected = chooseFromList(@duplicatesCandidates, "Selecciona las versiones que quieres eliminar", true, false)
                @duplicatesCount = count(@duplicatesSelected)
                confirm("Se enviarán {@duplicatesCount} archivos a Eliminados recientemente.", "Confirmar limpieza")
                deleteFiles(@duplicatesSelected, false)
                alert("Limpieza terminada.")
        }

    item "Salir":
        stop()
}
